pragma language_version 0.23.0;

import CompactStandardLibrary;

// ─── Public Ledger State ────────────────────────────────
export ledger contractAdmin: Bytes<32>;
export ledger credentials: Map<Bytes<32>, Bytes<32>>;
export ledger issuerRegistry: Map<Bytes<32>, Boolean>;
export ledger revoked: Set<Bytes<32>>;

// ─── Private Witnesses ──────────────────────────────────
witness adminSecret(): Bytes<32>;
witness issuerSecret(): Bytes<32>;
witness credentialScore(): Uint<16>;
witness credentialSalt(): Bytes<32>;
witness holderSecret(): Bytes<32>;

// ─── Identity Derivation ────────────────────────────────
export pure circuit deriveAdminPk(sk: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>(
        [pad(32, "kredit:admin:pk:"), sk]);
}

circuit issuerPk(sk: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>(
        [pad(32, "kredit:issuer:pk:"), sk]);
}

circuit holderKey(addr: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>(
        [pad(32, "kredit:holder:"), addr]);
}

circuit credCommit(score: Uint<16>, salt: Bytes<32>): Bytes<32> {
    return persistentCommit<Uint<16>>(score, salt);
}

// ─── Constructor ─────────────────────────────────────────
constructor(adminId: Bytes<32>) {
    contractAdmin = disclose(deriveAdminPk(adminSecret())); // disclose: minimal — reveals only the admin public key derivation
}

// ─── Admin Circuits ──────────────────────────────────────
export circuit rotateAdmin(newAdmin: Bytes<32>): [] {
    assert(contractAdmin == deriveAdminPk(adminSecret()), "Not admin");
    contractAdmin = disclose(newAdmin); // disclose: minimal — reveals only the new admin public key
}

export circuit registerIssuer(issuerId: Bytes<32>): [] {
    assert(contractAdmin == deriveAdminPk(adminSecret()), "Not admin");
    const pk = issuerPk(issuerSecret());
    issuerRegistry.insert(disclose(pk), true); // disclose: minimal — reveals only the issuer public key
}

export circuit unregisterIssuer(issuerId: Bytes<32>): [] {
    assert(contractAdmin == deriveAdminPk(adminSecret()), "Not admin");
    const pk = issuerPk(issuerSecret());
    issuerRegistry.remove(disclose(pk)); // disclose: minimal — reveals only the issuer public key
}

// ─── Issuer Circuits ─────────────────────────────────────
export circuit issueCredential(subject: Bytes<32>): [] {
    const pk = issuerPk(issuerSecret());
    assert(issuerRegistry.member(disclose(pk)), "Not registered issuer"); // disclose: minimal — reveals only the issuer public key

    const score = credentialScore();
    const salt = credentialSalt();
    const commit = credCommit(score, salt);

    const hKey = holderKey(disclose(subject)); // disclose: minimal — reveals only the subject address
    assert(!credentials.member(hKey), "Already exists");
    credentials.insert(hKey, disclose(commit)); // disclose: minimal — reveals only the credential commitment
}

export circuit revokeCredential(subject: Bytes<32>): [] {
    const pk = issuerPk(issuerSecret());
    assert(issuerRegistry.member(disclose(pk)), "Not registered issuer"); // disclose: minimal — reveals only the issuer public key

    const hKey = holderKey(disclose(subject)); // disclose: minimal — reveals only the subject address
    assert(credentials.member(hKey), "No credential");
    revoked.insert(hKey);
}

// ─── User / Verifier Circuits ───────────────────────────
export circuit proveEligibility(threshold: Uint<16>): Boolean {
    const score = credentialScore();
    const salt = credentialSalt();
    const holder = holderSecret();

    const hKey = holderKey(disclose(holder)); // disclose: minimal — reveals only the holder secret
    assert(credentials.member(hKey), "No credential");
    assert(!revoked.member(hKey), "Credential revoked");

    const stored = credentials.lookup(hKey);
    const computed = credCommit(score, salt);
    assert(stored == computed, "Invalid commitment");

    return disclose(score >= threshold); // disclose: minimal — reveals only the boolean eligibility result
}

export circuit proveNotRevoked(): Boolean {
    const holder = holderSecret();
    const hKey = holderKey(disclose(holder)); // disclose: minimal — reveals only the holder secret
    return disclose(!revoked.member(hKey)); // disclose: minimal — reveals only the boolean revocation status
}
