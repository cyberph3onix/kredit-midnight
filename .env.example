# ZK Artifacts Server (serves compiled keys/ZKIR on port 3100)
# Leave empty to serve the artifacts from the frontend's own /public (same
# origin) — the app falls back to window.location.origin automatically.
# Do NOT set this to an empty string explicitly; the underlying SDK throws
# "Failed to construct 'URL': Invalid URL" if it receives one directly.
NEXT_PUBLIC_ZK_ARTIFACTS_URL=http://localhost:3100

# Address of the Kredit contract already deployed on Preprod (from the Issuer
# console's "Deploy Kredit contract" step). Required so that Verify/User pages
# work for visitors who haven't deployed their own contract. Leave empty only
# for local testing where you'll deploy via the Issuer console yourself.
NEXT_PUBLIC_CONTRACT_ADDRESS=